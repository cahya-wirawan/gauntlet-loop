# External providers are optional. Native Claude Code agents always work without these.

# OpenAI (set OPENAI_BASE_URL to point at a local/self-hosted OpenAI-compatible
# proxy instead of api.openai.com -- e.g. http://127.0.0.1:8000/v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GAUNTLET_OPENAI_MODEL=gpt-5.6

# Google Gemini
GEMINI_API_KEY=
GAUNTLET_GEMINI_MODEL=gemini-3.6-flash

# Anthropic API (separate API call, optional; native Claude agents do not require this)
# Set ANTHROPIC_BASE_URL to point at a gateway/proxy instead of api.anthropic.com
# -- host, /v1, or the full /v1/messages path all work.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GAUNTLET_ANTHROPIC_MODEL=claude-opus-5

# Ollama/local
OLLAMA_BASE_URL=http://localhost:11434
GAUNTLET_OLLAMA_MODEL=qwen3:32b
