# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODE=responses
GAUNTLET_OPENAI_MODEL=gpt-5.6

# For an OpenAI-compatible gateway instead:
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_MODE=chat_completions
# GAUNTLET_OPENAI_MODEL=my-model

# Anthropic (set ANTHROPIC_BASE_URL to point at a gateway/proxy instead of
# api.anthropic.com -- host, /v1, or the full /v1/messages path all work)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GAUNTLET_ANTHROPIC_MODEL=claude-sonnet-5

# Gemini
GEMINI_API_KEY=
GAUNTLET_GEMINI_MODEL=gemini-3.1-pro-preview

# Ollama / local
OLLAMA_BASE_URL=http://localhost:11434
GAUNTLET_OLLAMA_MODEL=qwen3:32b
